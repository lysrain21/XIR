{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xir.example/schemas/funding-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "payload",
    "effects"
  ],
  "properties": {
    "schema_version": {"const": "xir-lab-funding-request-v1"},
    "request_id": {"type": "string", "pattern": "^funding_[0-9a-f]{24}$"},
    "request_sha256": {"$ref": "#/$defs/digest"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "config_sha256",
        "generated_at",
        "expires_at",
        "targets",
        "prohibited_actions"
      ],
      "properties": {
        "domain": {"const": "xir-lab-funding-request-v1"},
        "config_sha256": {"$ref": "#/$defs/digest"},
        "generated_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "targets": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/target"}
        },
        "prohibited_actions": {
          "const": [
            "automatic_faucet_claim",
            "automatic_bridge",
            "mainnet_transfer",
            "asset_purchase"
          ]
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallets_created",
        "funding_operations",
        "signing_operations",
        "broadcasts"
      ],
      "properties": {
        "wallets_created": {"const": 0},
        "funding_operations": {"const": 0},
        "signing_operations": {"const": 0},
        "broadcasts": {"const": 0}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "network_name",
        "native_test_token",
        "role",
        "recipient",
        "observed_balance_wei",
        "estimated_spend_wei",
        "balance_floor_wei",
        "required_manual_deposit_wei",
        "maximum_manual_deposit_wei",
        "approved_budget_wei"
      ],
      "properties": {
        "chain_id": {"enum": [11155420, 421614, 84532]},
        "network_name": {"type": "string", "minLength": 1},
        "native_test_token": {"type": "string", "minLength": 1},
        "role": {"enum": ["deployer", "runner"]},
        "recipient": {"$ref": "#/$defs/address"},
        "observed_balance_wei": {"type": "integer", "minimum": 0},
        "estimated_spend_wei": {"type": "integer", "minimum": 0},
        "balance_floor_wei": {"type": "integer", "minimum": 0},
        "required_manual_deposit_wei": {"type": "integer", "minimum": 0},
        "maximum_manual_deposit_wei": {"type": "integer", "minimum": 0},
        "approved_budget_wei": {"type": "integer", "minimum": 0}
      }
    }
  }
}
