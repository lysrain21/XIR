{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xir.example/schemas/native-faults-v1-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "routes",
    "repetitions_per_route_scenario",
    "coordinator_stage",
    "scenarios"
  ],
  "properties": {
    "schema_version": {"const": "xir-lab-native-faults-v1-config-v1"},
    "campaign_id": {
      "enum": ["native-faults-v1-smoke", "native-faults-v1-frozen"]
    },
    "routes": {
      "type": "array",
      "prefixItems": [{"const": "HL"}, {"const": "LH"}],
      "items": false
    },
    "repetitions_per_route_scenario": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "coordinator_stage": {"const": "destination_deliver"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"campaign_id": {"const": "native-faults-v1-frozen"}}},
      "then": {
        "properties": {
          "repetitions_per_route_scenario": {"minimum": 3},
          "scenarios": {"minItems": 10}
        }
      }
    }
  ],
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "actor", "boundary", "signal"],
      "properties": {
        "name": {
          "enum": [
            "pre_intent",
            "post_intent_pre_sign",
            "post_sign_pre_broadcast",
            "post_broadcast_pre_acknowledgement",
            "post_acknowledgement_pre_mining",
            "post_mining_pre_persistence",
            "post_persistence_pre_stage_commit",
            "worker_action_post_submit",
            "transient_retry_after_broadcast",
            "concurrent_retry"
          ]
        },
        "actor": {"enum": ["coordinator", "worker"]},
        "boundary": {
          "enum": [
            "pre_intent",
            "post_intent_pre_sign",
            "post_sign_pre_broadcast",
            "post_broadcast_pre_acknowledgement",
            "post_acknowledgement_pre_mining",
            "post_mining_pre_persistence",
            "post_persistence_pre_stage_commit",
            "worker_action_post_submit"
          ]
        },
        "signal": {
          "enum": ["process_exit", "transient_retry", "concurrent_retry"]
        },
        "target_stage": {"type": "string", "minLength": 1}
      }
    }
  }
}
