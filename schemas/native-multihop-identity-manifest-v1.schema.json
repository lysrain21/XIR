{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xir.local/schemas/native-multihop-identity-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "payload_sha256", "payload"],
  "properties": {
    "schema_version": {"const": "xir-lab-local-identity-manifest-v1"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "topology_sha256", "created_at", "development_only", "accounts", "networks"],
      "properties": {
        "domain": {"const": "xir-lab-local-identity-manifest-v1"},
        "topology_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "development_only": {"const": true},
        "accounts": {
          "type": "object", "additionalProperties": false, "required": ["deployer", "runner"],
          "properties": {"deployer": {"$ref": "#/$defs/address"}, "runner": {"$ref": "#/$defs/address"}}
        },
        "networks": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/network"}}
      }
    }
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9A-Fa-f]{40}$"},
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["network_id", "chain_id", "genesis_path", "genesis_sha256", "validators"],
      "properties": {
        "network_id": {"type": "string", "pattern": "^local-chain-[a-e]$"},
        "chain_id": {"type": "integer", "minimum": 1000000},
        "genesis_path": {"type": "string", "minLength": 1},
        "genesis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "validators": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/validator"}}
      }
    },
    "validator": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_id", "address", "public_key", "enode", "private_key_path"],
      "properties": {
        "validator_id": {"type": "string", "pattern": "^v[1-4]$"},
        "address": {"$ref": "#/$defs/address"},
        "public_key": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
        "enode": {"type": "string", "pattern": "^enode://[0-9a-f]{128}@[0-9.]+:30303$"},
        "private_key_path": {"type": "string", "minLength": 1}
      }
    }
  }
}
