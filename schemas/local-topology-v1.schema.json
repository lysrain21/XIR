{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xir.example/schemas/local-topology-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "topology_id",
    "project_name",
    "besu_image",
    "validator_data_storage",
    "runtime_root_environment_variable",
    "allowed_rpc_hosts",
    "public_chain_id_denylist",
    "networks",
    "resource_policy"
  ],
  "properties": {
    "schema_version": {"const": "xir-lab-local-topology-v1"},
    "topology_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "project_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "besu_image": {
      "type": "string",
      "pattern": "^hyperledger/besu@sha256:[0-9a-f]{64}$"
    },
    "validator_data_storage": {
      "enum": ["runtime-bind", "docker-volume"]
    },
    "runtime_root_environment_variable": {"const": "XIR_LOCAL_RUNTIME_ROOT"},
    "allowed_rpc_hosts": {
      "type": "array",
      "const": ["127.0.0.1", "localhost"]
    },
    "rpc_http_apis": {
      "type": "array",
      "items": {"enum": ["ETH", "NET", "QBFT", "WEB3", "DEBUG", "TRACE"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "public_chain_id_denylist": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 3,
      "uniqueItems": true
    },
    "networks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/network"}
    },
    "resource_policy": {"$ref": "#/$defs/resourcePolicy"}
  },
  "additionalProperties": false,
  "$defs": {
    "network": {
      "type": "object",
      "required": [
        "network_id",
        "route_role",
        "chain_id",
        "host_rpc_port",
        "subnet",
        "validator_count",
        "block_period_seconds",
        "request_timeout_seconds",
        "gas_limit"
      ],
      "properties": {
        "network_id": {"type": "string", "pattern": "^local-[a-z0-9-]+$"},
        "route_role": {"enum": ["source", "intermediate", "destination"]},
        "chain_id": {"type": "integer", "minimum": 1000000},
        "host_rpc_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "subnet": {
          "type": "string",
          "pattern": "^172\\.28\\.[0-9]{1,3}\\.0/24$"
        },
        "validator_count": {"const": 4},
        "block_period_seconds": {"type": "integer", "minimum": 1},
        "request_timeout_seconds": {"type": "integer", "minimum": 2},
        "gas_limit": {"type": "string", "pattern": "^0x[0-9a-f]+$"}
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": [
        "minimum_logical_cpus",
        "minimum_memory_bytes",
        "minimum_disk_available_bytes"
      ],
      "properties": {
        "minimum_logical_cpus": {"type": "integer", "minimum": 1},
        "minimum_memory_bytes": {"type": "integer", "minimum": 1},
        "minimum_disk_available_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "resourcePolicy": {
      "type": "object",
      "required": [
        "render",
        "smoke",
        "scale",
        "validator_memory_bytes",
        "validator_cpu_limit"
      ],
      "properties": {
        "render": {"$ref": "#/$defs/thresholds"},
        "smoke": {"$ref": "#/$defs/thresholds"},
        "scale": {"$ref": "#/$defs/thresholds"},
        "validator_memory_bytes": {"type": "integer", "minimum": 268435456},
        "validator_cpu_limit": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    }
  }
}
