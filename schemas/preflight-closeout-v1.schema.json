{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xir.example/schemas/preflight-closeout-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_type",
    "operation_id",
    "approval_id",
    "network_identity_sha256",
    "contracts"
  ],
  "properties": {
    "schema_version": {"const": "xir-lab-preflight-closeout-v1"},
    "operation_type": {"const": "closeout"},
    "operation_id": {"type": "string", "minLength": 1},
    "approval_id": {"type": "string", "minLength": 1},
    "network_identity_sha256": {"$ref": "#/$defs/digest"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contract"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "network": {
      "enum": ["op-sepolia", "arbitrum-sepolia", "base-sepolia"]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "network_id",
        "address",
        "runtime_code_sha256",
        "administrator",
        "expected_current_state_sha256",
        "authorized_action"
      ],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "network_id": {"$ref": "#/$defs/network"},
        "address": {"$ref": "#/$defs/address"},
        "runtime_code_sha256": {"$ref": "#/$defs/digest"},
        "administrator": {"$ref": "#/$defs/address"},
        "expected_current_state_sha256": {"$ref": "#/$defs/digest"},
        "authorized_action": {
          "enum": ["pause", "revoke-runner", "disable-profile"]
        }
      }
    }
  }
}
