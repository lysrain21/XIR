{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xir.example/schemas/funding-handoff-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "payload", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "xir-lab-funding-handoff-v1"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "request_sha256", "receipts"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^funding_[0-9a-f]{24}$"},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/receipt"}
        }
      }
    },
    "payload_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "txHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "wei": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "role",
        "recipient",
        "transaction_hash",
        "amount_wei",
        "observation_block",
        "observation_block_hash",
        "resulting_balance_wei",
        "observed_at"
      ],
      "properties": {
        "chain_id": {"enum": [11155420, 421614, 84532]},
        "role": {"enum": ["deployer", "runner"]},
        "recipient": {"$ref": "#/$defs/address"},
        "transaction_hash": {"$ref": "#/$defs/txHash"},
        "amount_wei": {"$ref": "#/$defs/wei"},
        "observation_block": {"type": "integer", "minimum": 0},
        "observation_block_hash": {"$ref": "#/$defs/txHash"},
        "resulting_balance_wei": {"$ref": "#/$defs/wei"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
