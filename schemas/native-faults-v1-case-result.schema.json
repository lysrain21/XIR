{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xir.example/schemas/native-faults-v1-case-result.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "case_key",
    "attempt_id",
    "route",
    "scenario",
    "repetition",
    "actor",
    "boundary",
    "signal",
    "nonce_lineage",
    "transaction_lineage",
    "raw_transaction_lineage",
    "application_event_transaction_hashes",
    "checks",
    "valid"
  ],
  "properties": {
    "schema_version": {"const": "xir-lab-native-faults-v1-case-result-v1"},
    "case_key": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "pattern": "^fault_[0-9a-f]{32}$"},
    "route": {"enum": ["HL", "LH"]},
    "scenario": {"type": "string", "minLength": 1},
    "repetition": {"type": "integer", "minimum": 0},
    "actor": {"enum": ["coordinator", "worker"]},
    "boundary": {"type": "string", "minLength": 1},
    "signal": {"enum": ["process_exit", "transient_retry", "concurrent_retry"]},
    "nonce_lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "transaction_lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}
    },
    "raw_transaction_lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "application_event_transaction_hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}
    },
    "checks": {"type": "object", "minProperties": 1},
    "valid": {"const": true}
  }
}
