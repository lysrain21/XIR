{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xir.example/schemas/native-component-lock-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "components", "formal_exclusions"],
  "properties": {
    "schema_version": {"const": "xir-lab-native-component-lock-v1"},
    "components": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "official_repository",
          "commit",
          "role",
          "license_paths",
          "build"
        ],
        "properties": {
          "component_id": {
            "enum": ["hyperlane", "layerzero-v2", "layerzero-devtools"]
          },
          "official_repository": {
            "type": "string",
            "pattern": "^https://github\\.com/"
          },
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "role": {"enum": ["formal-runtime", "build-reference"]},
          "license_paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "build": {
            "type": "object",
            "required": ["working_directory", "commands", "expected_outputs"],
            "properties": {
              "working_directory": {"type": "string"},
              "commands": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "expected_outputs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "formal_exclusions": {
      "const": [
        "TestIsm",
        "MockMailbox",
        "EndpointV2Mock",
        "SendUln302Mock",
        "ReceiveUln302Mock",
        "DVNMock",
        "ExecutorMock",
        "SimpleMessageLib"
      ]
    }
  },
  "additionalProperties": false
}
