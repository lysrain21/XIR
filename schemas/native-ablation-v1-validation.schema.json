{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xir.local/schemas/native-ablation-v1-validation.schema.json",
  "type": "object",
  "required": [
    "schema_version", "valid", "phase", "expected_attempts",
    "reconciled_attempts", "application_effects", "cell_counts",
    "mechanism_matrix", "mechanism_deltas", "mechanism_nesting_valid",
    "matched_payload_blocks", "paired_increment_counts",
    "scale_minimum_satisfied", "physical_lineage_complete",
    "complete_physical_transactions", "reconciliation_errors",
    "b1_exact_wire_checks", "b1_exact_wire_rebuild_valid",
    "b1_layerzero_size_checks", "b1_layerzero_size_valid",
    "coordinator_retry_count", "retry_free_complete_lineage",
    "analyzer_transaction_read_retry_count"
    , "operational_incident_count", "operational_incident_logs_valid",
    "operational_incident_source_snapshots_valid", "operational_incidents_recovered",
    "incident_latency_sensitivity_required",
    "incident_latency_sensitivity_valid", "incident_latency_sensitivity_included_attempts",
    "incident_latency_sensitivity_excluded_attempts",
    "incident_latency_sensitivity_included_blocks",
    "incident_latency_sensitivity_excluded_blocks",
    "incident_latency_sensitivity_cell_counts", "incident_latency_sensitivity_paired_counts"
  ],
  "properties": {
    "schema_version": {"const": "xir-lab-native-ablation-v1-validation"},
    "valid": {"type": "boolean"},
    "phase": {"enum": ["smoke", "scale"]},
    "expected_attempts": {"type": "integer", "minimum": 1},
    "reconciled_attempts": {"type": "integer", "minimum": 0},
    "application_effects": {"type": "integer", "minimum": 0},
    "cell_counts": {
      "type": "object",
      "required": ["HL_B0", "HL_B1", "HL_B2", "HL_B3", "LH_B0", "LH_B1", "LH_B2", "LH_B3"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "mechanism_matrix": {"type": "object"},
    "mechanism_deltas": {"type": "object"},
    "mechanism_nesting_valid": {"const": true},
    "matched_payload_blocks": {"type": "integer", "minimum": 1},
    "paired_increment_counts": {"type": "object"},
    "scale_minimum_satisfied": {"const": true},
    "physical_lineage_complete": {"const": true},
    "complete_physical_transactions": {"type": "integer", "minimum": 0},
    "b1_exact_wire_checks": {"type": "integer", "minimum": 1},
    "b1_exact_wire_rebuild_valid": {"const": true},
    "b1_layerzero_size_checks": {"type": "integer", "minimum": 1},
    "b1_layerzero_size_valid": {"const": true},
    "coordinator_retry_count": {"const": 0},
    "retry_free_complete_lineage": {"const": true},
    "analyzer_transaction_read_retry_count": {"type": "integer", "minimum": 0},
    "operational_incident_count": {"type": "integer", "minimum": 0},
    "operational_incident_logs_valid": {"const": true},
    "operational_incident_source_snapshots_valid": {"const": true},
    "operational_incidents_recovered": {"const": true},
    "incident_latency_sensitivity_required": {"type": "boolean"},
    "incident_latency_sensitivity_valid": {"const": true},
    "incident_latency_sensitivity_included_attempts": {"type": "integer", "minimum": 1},
    "incident_latency_sensitivity_excluded_attempts": {"type": "integer", "minimum": 0},
    "incident_latency_sensitivity_included_blocks": {"type": "integer", "minimum": 1},
    "incident_latency_sensitivity_excluded_blocks": {"type": "integer", "minimum": 0},
    "incident_latency_sensitivity_cell_counts": {"type": "object"},
    "incident_latency_sensitivity_paired_counts": {"type": "object"},
    "reconciliation_errors": {"type": "array"}
  }
}
