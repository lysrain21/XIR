{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xir.local/schemas/native-ablation-v2-analysis.schema.json",
  "type": "object",
  "required": [
    "schema_version", "namespace", "result_role", "phase", "config_sha256",
    "analysis_source_sha256",
    "operational_incidents_sha256",
    "deployment_sha256", "base_deployment_sha256", "final_revision_source_sha256",
    "prior_verifier_bindings", "onchain_prior_verifier_bindings",
    "runner_state_sha256", "layerzero_state_sha256",
    "attempt_count", "physical_transaction_count", "cell_summary",
    "paired_deltas", "stage_costs", "incident_latency_sensitivity",
    "incident_free_latency_summary", "incident_free_latency_deltas",
    "validation", "semantic_digest"
  ],
  "properties": {
    "schema_version": {"const": "xir-lab-native-ablation-v2-analysis"},
    "namespace": {"const": "native-ablation-v2"},
    "result_role": {"const": "final_mechanism_cost_estimate"},
    "phase": {"enum": ["smoke", "scale"]},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operational_incidents_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "deployment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_deployment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_revision_source_sha256": {"type": "object", "minProperties": 4},
    "prior_verifier_bindings": {"type": "object", "minProperties": 2},
    "onchain_prior_verifier_bindings": {"type": "object", "minProperties": 2},
    "runner_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "layerzero_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt_count": {"type": "integer", "minimum": 1},
    "physical_transaction_count": {"type": "integer", "minimum": 1},
    "cell_summary": {"type": "array", "minItems": 8, "maxItems": 8},
    "paired_deltas": {"type": "array", "minItems": 1},
    "stage_costs": {"type": "array", "minItems": 1},
    "incident_latency_sensitivity": {"type": "object"},
    "incident_free_latency_summary": {"type": "array", "minItems": 8, "maxItems": 8},
    "incident_free_latency_deltas": {"type": "array", "minItems": 1},
    "validation": {"type": "object"},
    "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
